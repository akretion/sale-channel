<odoo>
    <record id="sale_channel_view_form" model="ir.ui.view">
        <field name="model">sale.channel</field>
        <field name="inherit_id" ref="sale_channel.sale_channel_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="%(action_sale_channel_import_file)d"
                    type="action"
                    class="oe_highlight"
                    attrs="{'invisible': [('sale_import_file_format', '=', False)]}"
                    context="{'default_sale_channel_id': active_id}"
                    string="Import Sale Orders"
                />
            </xpath>
            <field name="channel_type" position="after">
                <field name="sale_import_file_format" />
            </field>
        </field>
    </record>
</odoo>
